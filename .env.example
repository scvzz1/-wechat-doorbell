# Copy to .env (or export directly) when using brains/brain_api.py
BRAIN_API_BASE=https://api.openai.com/v1
BRAIN_API_KEY=sk-...
BRAIN_MODEL=gpt-4o-mini

# Optional: speech model size for inbound voice transcription
# (tiny / base / small / medium / large-v3 — small is a good CPU default)
WHISPER_MODEL=small
